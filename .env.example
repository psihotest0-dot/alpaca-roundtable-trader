# Alpaca Roundtable Trader
# MVP uses PAPER TRADING only. Do not put real live account keys here.

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
DATA_FEED=iex
IS_PAPER=true

# Oracle Settings
ORACLE_ENABLED=false
# null = every signal passes (no real Oracle yet)
ORACLE_PROVIDER=null
ORACLE_TIMEOUT_SECONDS=10

# System Settings
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./var/trading.db
# The strategy research's own candle file (`fetch-daily`); a cache, never the trading database
RESEARCH_DATABASE_URL=sqlite:///./var/research.db
# The news cache (`fetch-news`), also its own file
NEWS_DATABASE_URL=sqlite:///./var/news.db
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9100

# Strategy Settings
TIMEFRAME_MINUTES=15
HTF_TIMEFRAME_MINUTES=60
LOOKBACK_DAYS=30
HTF_LOOKBACK_DAYS=90

# Risk Management
POSITION_SIZE_PCT=0.04
MAX_OPEN_POSITIONS=5
MAX_GROSS_EXPOSURE_PCT=0.20
MAX_PLANNED_RISK_PER_TRADE_PCT=0.002
MAX_TOTAL_PLANNED_OPEN_RISK_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02

# Trade Management
STOP_LOSS_PCT=0.04
TAKE_PROFIT_PCT=0.05
# Entry limit price = last price + this buffer (0.001 = 0.1 %); stop and target are measured from it
ENTRY_LIMIT_BUFFER_PCT=0.001
# No entry unless the last trade is at most this many seconds old and within this fraction of the last bar close
LIVE_PRICE_MAX_AGE_SECONDS=120
LIVE_PRICE_MAX_DEVIATION_PCT=0.05
ALLOW_FRACTIONAL=false
# A position without an active stop always halts trading; true also sends a market order to close it
EMERGENCY_CLOSE_UNPROTECTED=false
# Stopping the system (Ctrl+C, docker stop): false = a restart carries on by itself, true = entries are
# paused and the next start waits for `resume-entries` (`run --pause-on-exit` does it for one run)
PAUSE_ON_SHUTDOWN=false

# Watchlist
WATCHLIST=AAPL,MSFT,NVDA,AMD,GOOGL,TSLA,INTC,META,AMZN,SOFI,PLTR,COIN,MSTR,SHOP,ORCL,MU,NKE,AAL,RIG,MARA,OPEN,PATH
