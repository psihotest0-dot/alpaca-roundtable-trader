# Keep line endings stable no matter who commits (Windows autocrlf, CI, Docker).
* text=auto eol=lf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# The lock file is generated: GitHub collapses it in pull requests, but keep it
# diffable locally so dependency changes can still be reviewed.
poetry.lock linguist-generated=true
